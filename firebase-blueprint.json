{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "User account with role-based access control",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoUrl": { "type": "string", "maxLength": 1024 },
        "company": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["manager", "supervisor", "client", "worker"] },
        "phone": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "email", "role"]
    },
    "clientProfile": {
      "title": "Client Enterprise Profile",
      "description": "Registered company or client contractor profile",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 256 },
        "commercialRegister": { "type": "string", "maxLength": 64 },
        "taxNumber": { "type": "string", "maxLength": 64 },
        "industrySector": { "type": "string", "maxLength": 128 },
        "contactPerson": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "headquarters": { "type": "string", "maxLength": 256 },
        "assignedSupervisorId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["verified", "pending", "inactive"] },
        "creditLimit": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["clientId", "companyName", "contactPerson", "phone", "email"]
    },
    "workOrder": {
      "title": "Work Order / Request",
      "description": "Formal industrial service work order or client request",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 128 },
        "serviceType": { "type": "string", "maxLength": 64 },
        "siteName": { "type": "string", "maxLength": 256 },
        "governorate": { "type": "string", "maxLength": 128 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "scopeDescription": { "type": "string", "maxLength": 2048 },
        "jointsCount": { "type": "number" },
        "equipmentAssigned": { "type": "string", "maxLength": 256 },
        "assignedSupervisorId": { "type": "string", "maxLength": 128 },
        "assignedWorkerIds": { "type": "string", "maxLength": 512 },
        "targetCompletionDate": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "urgent", "emergency"] },
        "status": { "type": "string", "enum": ["submitted", "approved", "technicians_dispatched", "in_progress", "testing_completed", "closed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "title", "clientId", "serviceType", "siteName", "status"]
    },
    "workerCheckIn": {
      "title": "Worker Location & Shift Check-In",
      "description": "Field worker attendance, GPS coordinates, and site presence tracking",
      "type": "object",
      "properties": {
        "checkInId": { "type": "string", "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "workerName": { "type": "string", "maxLength": 128 },
        "craft": { "type": "string", "maxLength": 64 },
        "siteName": { "type": "string", "maxLength": 256 },
        "orderId": { "type": "string", "maxLength": 128 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "status": { "type": "string", "enum": ["on_site", "active_testing", "heat_soaking", "traveling", "off_duty"] },
        "checkInTime": { "type": "string" },
        "lastPing": { "type": "string" },
        "notes": { "type": "string", "maxLength": 1024 }
      },
      "required": ["checkInId", "workerId", "workerName", "siteName", "status"]
    },
    "dailyFieldReport": {
      "title": "Daily Field Work Report",
      "description": "Progress report logged by technicians on active work orders",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "workerName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string" },
        "serviceMethod": { "type": "string", "maxLength": 64 },
        "weldsCompleted": { "type": "number" },
        "hoursWorked": { "type": "number" },
        "temperatureMax": { "type": "number" },
        "supervisorSignOff": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["draft", "submitted", "approved"] },
        "notes": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" }
      },
      "required": ["reportId", "orderId", "workerId", "serviceMethod", "status"]
    },
    "serviceRequest": {
      "title": "Service Request & RFQ",
      "description": "Client requested NDT or PWHT service inquiry and quotation",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 128 },
        "contactPhone": { "type": "string", "maxLength": 64 },
        "serviceType": { "type": "string", "maxLength": 64 },
        "assetType": { "type": "string", "maxLength": 64 },
        "material": { "type": "string", "maxLength": 64 },
        "location": { "type": "string", "maxLength": 128 },
        "urgency": { "type": "string", "maxLength": 32 },
        "rfqReference": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["submitted", "reviewing", "scheduled", "completed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["requestId", "userId", "serviceType", "location"]
    },
    "inquiry": {
      "title": "Customer Technical Inquiry",
      "description": "Recorded consultation with AI advisor",
      "type": "object",
      "properties": {
        "inquiryId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userQuestion": { "type": "string", "maxLength": 2048 },
        "aiAnswer": { "type": "string", "maxLength": 10000 },
        "category": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["inquiryId", "userId", "userQuestion"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User account documents with role authorization"
    },
    "/clients/{clientId}": {
      "schema": "clientProfile",
      "description": "Enterprise client records and company data"
    },
    "/workOrders/{orderId}": {
      "schema": "workOrder",
      "description": "Work orders and project task dispatches"
    },
    "/workerCheckIns/{checkInId}": {
      "schema": "workerCheckIn",
      "description": "Field worker presence, coordinates, and site tracking"
    },
    "/fieldReports/{reportId}": {
      "schema": "dailyFieldReport",
      "description": "Daily technical work execution reports"
    },
    "/serviceRequests/{requestId}": {
      "schema": "serviceRequest",
      "description": "Client service orders and RFQ bookings"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Saved technical consultations"
    }
  }
}
