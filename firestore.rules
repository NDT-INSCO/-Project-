rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    // Clients Collection (تسجيل بيانات العملاء)
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(clientId);
      allow delete: if isSignedIn();
    }

    // Work Orders (طلبات العمل)
    match /workOrders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(orderId);
      allow delete: if isSignedIn();
    }

    // Worker Location & Shift Tracking (هيكل تتبع العاملين وأماكن تواجدهم)
    match /workerCheckIns/{checkInId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(checkInId);
      allow delete: if isSignedIn();
    }

    // Daily Field Reports
    match /fieldReports/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(reportId);
      allow delete: if isSignedIn();
    }

    // Service Requests & RFQs
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(requestId);
      allow delete: if isSignedIn();
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(inquiryId);
      allow delete: if isSignedIn();
    }

    // Quiz Leaderboard Collection (لوحة المتصدرين العالمية للاختبارات)
    match /quizLeaderboard/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId);
      allow delete: if isSignedIn();
    }

    // Test connection doc for validating setup
    match /test/connection {
      allow read: if true;
    }
  }
}
